# Copy to .env and fill in. .env is gitignored; this file must never hold a real key.
#   cp .env.example .env

# REQUIRED — Google Places API (New)
#   console.cloud.google.com -> APIs & Services
#     1. Enable "Places API (New)"  <- the NEW one; legacy Places uses other endpoints
#     2. Credentials -> Create credentials -> API key
#     3. Restrict the key to Places API (New) only
#     4. Set a hard quota cap (IAM & Admin -> Quotas) — a ceiling, not just a
#        budget alert, so a runaway loop is impossible rather than merely visible
#
#   Billing: Text Search Enterprise is $35 per 1,000 requests with 1,000 free
#   per month. Enterprise is required because the field mask asks for rating,
#   review count, price level and opening hours.
GOOGLE_MAPS_API_KEY=

# OPTIONAL — search bias for the one-time enrichment run.
# Defaults to downtown Toronto, 50km (50000 is the maximum Places accepts).
# Only affects enrichment, not recommendations while travelling.
HOME_LAT=43.6532
HOME_LNG=-79.3832
SEARCH_RADIUS_M=50000

# NOT NEEDED — the app makes no Claude API calls. Labelling runs in Claude Code.
# Only fill this in if you later want conversational features on the phone.
ANTHROPIC_API_KEY=
