# Copy to .env and fill in. .env is gitignored; this file must never hold a real key.
#   cp .env.example .env

# REQUIRED — Google Places API (New)
#   console.cloud.google.com -> APIs & Services
#     1. Enable "Places API (New)"  <- the NEW one; legacy Places uses other endpoints
#     2. Credentials -> Create credentials -> API key
#     3. Restrict the key to Places API (New) only
#     4. Set a hard quota cap (IAM & Admin -> Quotas) — a ceiling, not just a
#        budget alert, so a runaway loop is impossible rather than merely visible
#
#   Billing: Text Search Enterprise is $35 per 1,000 requests with 1,000 free
#   per month. Enterprise is required because the field mask asks for rating,
#   review count, price level and opening hours.
GOOGLE_MAPS_API_KEY=

# REQUIRED IN PRODUCTION — the single-user gate.
# A Vercel URL is public, and every /api call spends real Google quota, so the
# two Places routes refuse to run without this passcode. Leave it EMPTY locally
# and the routes stay open, which keeps dev to one command.
#
# Note what it does not do: public/places.json is a static asset and stays
# readable by anyone who has the URL. The saved list isn't the secret; the spend
# is. robots.txt keeps the URL out of search results.
APP_PASSCODE=

# REQUIRED IN PRODUCTION — signing key for photo URLs.
# /api/photo has to stay open to <img> tags, so it cannot ask for the passcode.
# Without this it would forward ANY well-formed Google photo name to Google on
# your key — including names harvested elsewhere — which is an unbounded bill.
# With it set, the build signs every name in photos.json and discovery signs the
# ones it returns, and the proxy refuses anything it didn't sign.
#
# Generate:  node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
#
# Must be identical at build time and run time — the build signs, the function
# verifies. Rotating it invalidates every signature, so redeploy (which rebuilds
# photos.json) immediately after. Leave EMPTY locally: unset means the proxy
# skips the check, which keeps dev to one command.
PHOTO_SECRET=

# OPTIONAL — search bias for the one-time enrichment run.
# Defaults to downtown Toronto, 50km (50000 is the maximum Places accepts).
# Only affects enrichment, not recommendations while travelling.
HOME_LAT=43.6532
HOME_LNG=-79.3832
SEARCH_RADIUS_M=50000

# NOT NEEDED — the app makes no Claude API calls. Labelling runs in Claude Code.
# Only fill this in if you later want conversational features on the phone.
ANTHROPIC_API_KEY=
