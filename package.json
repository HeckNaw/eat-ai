{
  "name": "chudly-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-web-data.mjs && vite",
    "build": "node scripts/build-web-data.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "data": "python3 scripts/import_lists.py && node scripts/label.mjs && node scripts/derive.mjs && node scripts/build-web-data.mjs",
    "enrich": "node --env-file=.env scripts/enrich.mjs",
    "label": "node scripts/label.mjs",
    "icons": "node scripts/make-icons.mjs",
    "derive": "node scripts/derive.mjs && node scripts/build-web-data.mjs",
    "discover": "node --env-file=.env scripts/discover.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}